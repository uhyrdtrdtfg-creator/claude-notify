# claude-notify server config. Copy to .env and fill in.

ADDR=:8080
DATA_DIR=./data

# Shared secret — the hook script and iOS app both send this as "Bearer <secret>".
# Generate with: openssl rand -hex 32
SHARED_SECRET=change-me-to-a-long-random-string

# APNs Auth Key (.p8 file) from Apple Developer Portal.
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YYYYYYYYYY
APNS_BUNDLE_ID=com.yourname.claudenotify

# sandbox (debug builds from Xcode) or production (TestFlight / App Store)
APNS_ENV=sandbox
