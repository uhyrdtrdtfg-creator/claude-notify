[Unit]
Description=Claude Notify relay server
After=network.target

[Service]
Type=simple
User=claude-notify
WorkingDirectory=/opt/claude-notify
EnvironmentFile=/etc/claude-notify/env
ExecStart=/usr/local/bin/claude-notify
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/claude-notify

[Install]
WantedBy=multi-user.target
